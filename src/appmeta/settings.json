{
  "format_version": 1,
  "version": 6,
  "fields": {
    "project": {
      "type": "string",
      "label": "Kickstarter project",
      "description": "creator/project from the URL, e.g. flipper-devices/flipper-one",
      "default": "flipper-devices/flipper-one",
      "max_length": 96
    },
    "name": {
      "type": "string",
      "label": "Short name",
      "description": "Shown on the countdown page",
      "default": "Flipper One",
      "max_length": 14
    },
    "deadline": {
      "type": "string",
      "label": "Campaign ends",
      "description": "UTC, like 2026-12-17T16:00:00Z",
      "default": "2026-12-17T16:00:00Z",
      "max_length": 25
    },
    "goal": {
      "type": "integer",
      "label": "Funding goal",
      "description": "0 hides the progress page",
      "default": 300000,
      "min": 0,
      "max": 100000000,
      "step": 1000
    },
    "milestone": {
      "type": "enum",
      "label": "Celebrate every",
      "default": "1000000",
      "options": [
        {
          "value": "0",
          "label": "Off"
        },
        {
          "value": "10000",
          "label": "10K"
        },
        {
          "value": "50000",
          "label": "50K"
        },
        {
          "value": "100000",
          "label": "100K"
        },
        {
          "value": "250000",
          "label": "250K"
        },
        {
          "value": "500000",
          "label": "500K"
        },
        {
          "value": "1000000",
          "label": "1M"
        }
      ]
    },
    "update_sec": {
      "type": "enum",
      "label": "Update every",
      "description": "Kickstarter itself refreshes these numbers about every 5 seconds",
      "default": "5",
      "options": [
        {
          "value": "5",
          "label": "5 seconds"
        },
        {
          "value": "15",
          "label": "15 seconds"
        },
        {
          "value": "30",
          "label": "30 seconds"
        },
        {
          "value": "60",
          "label": "1 minute"
        },
        {
          "value": "300",
          "label": "5 minutes"
        }
      ]
    },
    "rotate": {
      "type": "boolean",
      "label": "Rotate pages",
      "default": true
    },
    "rotate_sec": {
      "type": "integer",
      "label": "Seconds per page",
      "default": 8,
      "min": 3,
      "max": 60,
      "step": 1
    }
  }
}
